// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  googleId         String            @unique
  email            String            @unique
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  slackIntegration SlackIntegration?
  senders          Sender[]
  emailJobs        EmailJob[]
  rateLimitConfigs RateLimitConfig[]
}

model SlackIntegration {
  id                 String   @id @default(cuid())
  userId             String   @unique
  accessToken        String
  incomingWebhookUrl String
  teamName           String
  connectedAt        DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sender {
  id              String           @id @default(cuid())
  userId          String
  emailAddress    String
  displayName     String
  etherealUser    String
  etherealPass    String
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs       EmailJob[]
  rateLimitConfig RateLimitConfig?
}

enum EmailJobStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  RESCHEDULED
}

model EmailJob {
  id             String         @id @default(cuid())
  userId         String
  senderId       String
  bullJobId      String         @unique
  recipientEmail String
  subject        String
  body           String
  scheduledFor   DateTime
  status         EmailJobStatus @default(SCHEDULED)
  attempts       Int            @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         Sender         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model RateLimitConfig {
  id               String   @id @default(cuid())
  userId           String?
  senderId         String?  @unique
  maxEmailsPerHour Int      @default(10)
  minDelaySeconds  Int      @default(2)
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender           Sender?  @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
