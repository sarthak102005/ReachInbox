DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth — create at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth — create at https://api.slack.com/apps
# Required scopes: incoming-webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback

# JWT signing secret — must be at least 32 random characters
SESSION_SECRET=changeme_replace_with_at_least_32_random_chars

# Ethereal Email — leave blank to auto-generate a test account on startup
# The generated preview URL for each sent email is logged to stdout
ETHEREAL_USER=
ETHEREAL_PASS=

# Rate limiting defaults (can be overridden per-sender via the compose form)
MAX_EMAILS_PER_HOUR=10
MIN_DELAY_SECONDS=2

# BullMQ worker concurrency
WORKER_CONCURRENCY=5

PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
