# ==============================================================================
# ReachInbox Backend — Production Environment Variables
# ==============================================================================

NODE_ENV=production
PORT=4000

# PostgreSQL (uses docker-compose service name 'postgres')
DATABASE_URL=postgresql://reachinbox:CHANGE_TO_STRONG_PASSWORD@postgres:5432/reachinbox_prod?schema=public

# Redis (uses docker-compose service name 'redis')
REDIS_URL=redis://redis:6379

# Elasticsearch
# NOTE: Set to 'disabled' or leave empty in production. The app automatically
# falls back to PostgreSQL contains() search with zero external overhead.
ELASTICSEARCH_URL=disabled

# Frontend URL (must match your production domain with HTTPS)
FRONTEND_URL=https://yourdomain.com

# Session Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=GENERATE_A_RANDOM_32_BYTE_HEX_SECRET

# Google OAuth (Must match credentials configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Slack OAuth (Must match credentials configured in Slack API App Settings)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=https://yourdomain.com/api/slack/callback

# Ethereal Email SMTP Credentials (optional: will auto-provision on boot if omitted)
ETHEREAL_USER=
ETHEREAL_PASS=

# Rate Limiting & Queue Tuning
MAX_EMAILS_PER_HOUR=10
MIN_DELAY_SECONDS=2
WORKER_CONCURRENCY=5
